# ============================================
# Hotel Saigon Chatbot API Configuration
# ============================================
# Copy this file to .env and modify as needed

# ============================================
# Bot Identity Switch
# ============================================
# Choose bot identity: restaurant | robotics
#   restaurant → Saigon Indian Restaurant (menu, location, services)
#   robotics   → Chikku Robotics (AI & Robotics company)
BOT_IDENTITY=restaurant

# ============================================
# RAG Pipeline Settings (Optimized for Speed)
# ============================================
# Number of items to retrieve from vector database
TOP_K=7

# Number of items after reranking
RERANK_K=12

# ============================================
# FAQ Fast-Path (Performance Optimization)
# ============================================
# When enabled, the system checks FAQ/KB for an exact or high-confidence
# keyword match BEFORE running expensive semantic search (embedding + ChromaDB
# + LLM rewrite + reranking). If a match is found, the answer is returned
# instantly (<100ms) instead of going through the full 3-5s RAG pipeline.
#
# This is ideal for common factoid questions like:
#   "Who is your owner?", "Where are you located?", "Who founded Chikku?"
#
# Set to false ONLY if you want every query to go through semantic search
# for richer synthesized answers (at the cost of 3-5x more latency).
FAQ_FAST_PATH_ENABLED=true

# ============================================
# Voice Filler Signal (streaming /chat/voice endpoint)
# ============================================
# When enabled, the streaming /chat/voice endpoint emits a {'type':'filler'}
# event the instant the FAQ cache MISSES (step 3), BEFORE the slow hybrid
# retrieval + LLM steps run (4-6s). The frontend then speaks a filler sentence
# while waiting, then stops it and speaks the real response when it arrives.
# The frontend owns the filler text — the backend only sends the signal.
# Set to false to suppress ONLY the filler event (the stream still works).
FILLER_SIGNAL_ENABLED=true

# ============================================
# LLM Query Rewrite (for Semantic Retrieval)
# ============================================
# When enabled, the LLM rephrases user queries into 2-3 variants before
# semantic retrieval to improve recall on paraphrases. Adds ~300-800ms.
# Disable if latency is more important than recall for edge-case queries.
LLM_QUERY_REWRITE=true

# ============================================
# LLM Provider Switch
# ============================================
# Choose provider: ollama | openai
LLM_PROVIDER=ollama

# ============================================
# Ollama Models (used when LLM_PROVIDER=ollama)
# ============================================
# Embedding model for vector search
EMBEDDING_MODEL=mxbai-embed-large

# LLM model for response generation
# Using quantized model (q4_0 = 4-bit) for 2-3x faster inference
# Make sure to pull: ollama pull llama3:8b-instruct-q4_0
LLM_MODEL=llama3:8b-instruct-q4_0

# ============================================
# OpenAI Models (used when LLM_PROVIDER=openai)
# ============================================
# Your OpenAI API key
OPENAI_API_KEY=

# OpenAI chat model (gpt-4o-mini is fast & cheap; gpt-4o for best quality)
OPENAI_LLM_MODEL=gpt-4o-mini
# Note: embeddings always use Ollama (EMBEDDING_MODEL above) — no OpenAI embedding key needed

# ============================================
# Reranking Settings
# ============================================
# Enable reranking (adds ~200-500ms but significantly improves quality)
# Set to true to enable, false to disable
# RECOMMENDED: Enable for better quality, especially with top_k > 10
USE_RERANKING=true

# ============================================
# API Server Settings
# ============================================
# Host and port for the API server
API_HOST=0.0.0.0
API_PORT=8000

# ============================================
# Caching Settings
# ============================================
# Enable retrieval cache (speeds up repeated queries)
RAG_CACHE_ENABLED=true
RAG_CACHE_MAX_SIZE=100

# Enable embedding cache (speeds up embedding generation)
EMBEDDING_CACHE_ENABLED=true
EMBEDDING_CACHE_MAX_SIZE=200

# ============================================
# Response Quality & Validation
# ============================================
# Enable response quality validation (removes AI disclaimers)
ENABLE_RESPONSE_VALIDATION=true

# ============================================
# Rate Limiting (Production)
# ============================================
# Enable rate limiting to prevent abuse
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=60

# ============================================
# CORS Settings (Production)
# ============================================
# Comma-separated list of allowed origins
# Use "*" for development, specific domains for production
ALLOWED_ORIGINS=*

# ============================================
# API Timeout
# ============================================
# Request timeout in seconds
API_TIMEOUT=60

# ============================================
# Performance Notes
# ============================================
# With these optimizations:
# - Quantized model: 2-3x faster inference
# - Reduced tokens: 300 (was 500)
# - Reduced context: 2048 (was 4096)
# - Fewer retrieved items: Faster retrieval
# - Caching: Instant responses for repeated queries
# Expected speed improvement: 2-3x faster responses
