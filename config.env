# ============================================
# Hotel Saigon Chatbot API Configuration
# ============================================
# Copy this file to .env and modify as needed

# ============================================
# RAG Pipeline Settings (Optimized for Speed)
# ============================================
# Number of items to retrieve from vector database
# Reduced from 10 to 7 for faster processing
TOP_K=7

# Number of items after reranking
# Reduced from 5 to 4 for faster processing
RERANK_K=4

# ============================================
# Ollama Models
# ============================================
# Embedding model for vector search
EMBEDDING_MODEL=mxbai-embed-large

# LLM model for response generation
# Using quantized model (q4_0 = 4-bit) for 2-3x faster inference
# Make sure to pull: ollama pull llama3:8b-instruct-q4_0
LLM_MODEL=llama3:8b-instruct-q4_0

# ============================================
# Reranking Settings
# ============================================
# Enable reranking (slower but more accurate)
# Set to true to enable, false to disable
USE_RERANKING=false

# ============================================
# API Server Settings
# ============================================
# Host and port for the API server
API_HOST=0.0.0.0
API_PORT=8000

# ============================================
# Performance Notes
# ============================================
# With these optimizations:
# - Quantized model: 2-3x faster inference
# - Reduced tokens: 300 (was 500)
# - Reduced context: 2048 (was 4096)
# - Fewer retrieved items: Faster retrieval
# Expected speed improvement: 2-3x faster responses
