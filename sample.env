# ============================================
# Tenant Selection
# ============================================
# Which assistant this process serves:
#   saigon -> Saigon Indian Restaurant  (chroma_db / hotel_saigon_menu)
#   chikku -> Chikku Robotics support   (chikku_db / chikku_kb)
# Each tenant supplies its own vector store, system prompt, intents and
# validator rules. See src/tenant_config.py.
TENANT=saigon

# Optional per-field overrides (leave commented to use the tenant defaults):
# CHROMA_DIR=chroma_db
# COLLECTION_NAME=hotel_saigon_menu
# SYSTEM_PROMPT_FILE=data/system_prompt.txt

# ============================================
# Hotel Saigon Chatbot — Configuration
# ============================================

# ============================================
# LLM Provider  →  ollama | openai
# ============================================
LLM_PROVIDER=openai

# ============================================
# Ollama  (embeddings always use Ollama)
# ============================================
EMBEDDING_MODEL=mxbai-embed-large
LLM_MODEL=deepseek-r1:latest

# ============================================
# OpenAI  (only needed when LLM_PROVIDER=openai)
# ============================================
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_LLM_MODEL=gpt-4o-mini

# ============================================
# System Prompt (edit data/system_prompt.txt to change bot behavior)
# ============================================
# SYSTEM_PROMPT_FILE=data/system_prompt.txt  # leave unset: tenant supplies it

# ============================================
# Query Normalization (speech-to-text fix)
# ============================================
QUERY_NORMALIZATION=true

# ============================================
# Retrieval
# ============================================
TOP_K=15
RERANK_K=5
USE_RERANKING=false

# ============================================
# Caching
# ============================================
RAG_CACHE_ENABLED=true
RAG_CACHE_MAX_SIZE=100
EMBEDDING_CACHE_ENABLED=true
EMBEDDING_CACHE_MAX_SIZE=200

# ============================================
# API Server
# ============================================
API_HOST=0.0.0.0
API_PORT=8000
API_TIMEOUT=60
ALLOWED_ORIGINS=*

# ============================================
# Quality & Rate Limiting
# ============================================
ENABLE_RESPONSE_VALIDATION=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=60
