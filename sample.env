# ============================================
# Hotel Saigon Chatbot — Configuration
# ============================================

# ============================================
# Bot Identity Switch
# ============================================
# Choose bot identity: restaurant | robotics
BOT_IDENTITY=restaurant

# ============================================
# LLM Provider  →  ollama | openai
# ============================================
LLM_PROVIDER=openai

# ============================================
# Ollama  (embeddings always use Ollama)
# ============================================
EMBEDDING_MODEL=mxbai-embed-large
LLM_MODEL=deepseek-r1:latest

# ============================================
# OpenAI  (only needed when LLM_PROVIDER=openai)
# ============================================
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_LLM_MODEL=gpt-4o-mini

# ============================================
# System Prompt (edit data/system_prompt.txt to change bot behavior)
# ============================================
SYSTEM_PROMPT_FILE=data/system_prompt.txt

# ============================================
# Retrieval
# ============================================
TOP_K=15
RERANK_K=5
USE_RERANKING=false

# ============================================
# Voice Filler Signal (streaming /chat/voice endpoint)
# ============================================
# When enabled, the streaming /chat/voice endpoint emits a {'type':'filler'}
# event the instant the FAQ cache MISSES (step 3), BEFORE the slow hybrid
# retrieval + LLM steps run (4-6s). The frontend then speaks a filler sentence
# while waiting, then stops it and speaks the real response when it arrives.
# The frontend owns the filler text — the backend only sends the signal.
# Set to false to suppress ONLY the filler event (the stream still works).
FILLER_SIGNAL_ENABLED=true

# ============================================
# Caching
# ============================================
RAG_CACHE_ENABLED=true
RAG_CACHE_MAX_SIZE=100
EMBEDDING_CACHE_ENABLED=true
EMBEDDING_CACHE_MAX_SIZE=200

# ============================================
# API Server
# ============================================
API_HOST=0.0.0.0
API_PORT=8000
API_TIMEOUT=60
ALLOWED_ORIGINS=*

# ============================================
# Quality & Rate Limiting
# ============================================
ENABLE_RESPONSE_VALIDATION=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=60
